#!/usr/bin/env python3
"""Own the system clipboard, serving text/html plus a plain-text fallback.

Usage: richclip <html-file> <plain-file>

Reads both files, then forks into the background and holds the clipboard
until another application takes ownership (i.e. the user copies something
else). Set RICHCLIP_FOREGROUND=1 to stay in the foreground.
"""
import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, GObject, Gtk  # noqa: E402


def build_provider(html: bytes, plain: str) -> Gdk.ContentProvider:
    as_html = Gdk.ContentProvider.new_for_bytes("text/html", GLib.Bytes.new(html))
    as_text = Gdk.ContentProvider.new_for_value(GObject.Value(str, plain))
    return Gdk.ContentProvider.new_union([as_html, as_text])


def serve(html: bytes, plain: str) -> int:
    if not Gtk.init_check():
        print("richclip: no display available", file=sys.stderr)
        return 1

    clipboard = Gdk.Display.get_default().get_clipboard()
    if not clipboard.set_content(build_provider(html, plain)):
        print("richclip: could not take ownership of the clipboard", file=sys.stderr)
        return 1

    loop = GLib.MainLoop()
    clipboard.connect("changed", lambda cb: None if cb.is_local() else loop.quit())
    loop.run()
    return 0


def daemonize() -> None:
    """Detach so the calling shell gets its prompt back immediately."""
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    os.dup2(devnull, 0)
    os.dup2(devnull, 1)


if __name__ == "__main__":
    if len(sys.argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)

    # Read before backgrounding: the caller is free to delete its temp files
    # as soon as we return.
    with open(sys.argv[1], "rb") as fh:
        html_bytes = fh.read()
    with open(sys.argv[2], "r", encoding="utf-8") as fh:
        plain_text = fh.read()

    if os.environ.get("RICHCLIP_FOREGROUND") != "1":
        daemonize()
    sys.exit(serve(html_bytes, plain_text))
